{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["@cloudflare/vitest-pool-workers/types", "vite/client"]
  },
  "include": ["./**/*.ts", "../shared/**/*.ts", "../worker-configuration.d.ts"]
}
